# Copy to terraform.tfvars (gitignored) or pass with -var. Only
# admin_principal_arn is required; the rest show the defaults.
#
#   terraform -chdir=infra/bootstrap output -raw admin_principal_arn

admin_principal_arn = "arn:aws:iam::<account-id>:role/<your-admin-role>"

