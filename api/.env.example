# Local development values (compose). On EKS, credentials come from Pod Identity and
# S3_ENDPOINT_URL is unset. Never put real AWS keys in this file.
S3_BUCKET=qr-codes-local
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_KEY_PREFIX=qr_codes/
LOG_LEVEL=info
AWS_ACCESS_KEY_ID=qrlocal
AWS_SECRET_ACCESS_KEY=qrlocal-dev-only
