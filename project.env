# Project constants from docs/DESIGN.md section 10 (the contract).
# Plain KEY=value lines only (no quotes, no spaces): scripts source this file
# and the Makefile includes it. Terraform defaults in infra/ must match.
PROJECT=devops-qr
AWS_REGION=us-east-1
AZ_IDS=use1-az1,use1-az2
CLUSTER_NAME=devops-qr-eks
KUBERNETES_VERSION=1.36
KIND_CLUSTER=qr-kind
KIND_HTTP_PORT=8080
LOCAL_HTTP_PORT=3000
APP_NS=qr-app
MON_NS=monitoring
CW_NS=amazon-cloudwatch
ECR_REPO_API=devops-qr/api
ECR_REPO_WEB=devops-qr/web
LOCAL_TAG=dev
GH_REPO_NAME=devops-qr-capstone
TF_STATE_KEY=main/terraform.tfstate
KPS_RELEASE=kps
KPS_CHART=oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack
KPS_CHART_VERSION=93.4.0
GRAFANA_SVC=kps-grafana
GRAFANA_SECRET=grafana-admin
GRAFANA_LOCAL_PORT=3001
